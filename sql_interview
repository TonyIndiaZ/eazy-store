                                  JOINS 
                              ------------

1.INNER JOIN or JOIN : all matches recoreds from both tables
------------------------------
select e.emp_name , d.dept_name
from emp e
join dept d on e.dept_id = d.dept_id;


2.Left Join : all records from left table and only matched records from right table
-------------------------

select e.emp_name,d.dept_name
from emp e
left join dept d on e.dept_id=d.dept_id;

3.Right Join : all records from right table and only matched records from left table
-------------------------

select e.emp_name,d.dept_name
from emp e
right join dept d on e.dept_id=d.dept_id;

4. Qurey: --fetch details of ALL emp , their manager,their dept and the Projects they work on
---------------------------------------------------------------------------------------------
select e.emp_name,d.dept_name
from emp e
left join dept d on e.emp_id = d.dept_id
inner join manager m on m.manager_id = e.emp_id
left join project p on p.project_id = e.emp_id;
